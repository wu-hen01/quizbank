# 复制成 .env 后修改；改完要重启服务

# ---- 大模型（任意 OpenAI 兼容接口）----
# DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 本地 Ollama（先 ollama serve）
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# ---- 服务 ----
QUIZBANK_HOST=127.0.0.1
QUIZBANK_PORT=8765
# 留空 = 不校验。设了之后浏览器扩展选项页要填同样的值
QUIZBANK_TOKEN=

# ---- 截图 OCR（用 Windows 自带引擎，不需要装任何东西）----
# 1 = 开启，0 = 关闭（关闭后只能收录文字）
OCR_ENABLED=1
# 中文用 zh-Hans-CN，英文用 en-US
OCR_LANG=zh-Hans-CN
# 单张图片大小上限（字节），默认 12MB
# OCR_MAX_BYTES=12582912
